# Copy to .env.local and fill in from Supabase: Project Settings → API Keys.
# Both NEXT_PUBLIC_ values are public (sent to the browser); access is controlled by row-level security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Server-only secret key (used for invitations, notifications, signed URLs).
# NEVER prefix with NEXT_PUBLIC_ or import in client components.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
