# Copy to .env.local and fill in from Supabase: Project Settings → API Keys.
# Both NEXT_PUBLIC_ values are public (sent to the browser); access is controlled by row-level security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Server-only secret key (used for invitations, notifications, signed URLs).
# NEVER prefix with NEXT_PUBLIC_ or import in client components.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# Email notifications (Resend: resend.com → API Keys). Server-only; without it, only in-app notifications are sent.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Sender address on a domain verified in Resend (optional; this is the default)
NOTIFY_FROM_EMAIL="Team SYNCODE <portal@teamsyncode.com>"
# Public address used for links in emails (optional; defaults to the address the request came from)
PORTAL_URL=https://portal.teamsyncode.com
